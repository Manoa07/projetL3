# .env.example
# Copiez ce fichier vers .env puis renseignez les vraies valeurs.
# IMPORTANT : le code applicatif doit être modifié pour lire ces variables via os.getenv()
# au lieu d’utiliser des valeurs hardcodées dans les fichiers Python.

APP_ENV=development

POSTGRES_USER=appuser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=surveillance

# URL de connexion SQLAlchemy utilisée par le backend.
# Mode local sans Docker (par défaut) : host = localhost.
# Mode docker-compose : remplacez localhost par db.
DATABASE_URL=postgresql://appuser:change_me@localhost:5432/surveillance
